# ============================================================
#  فاکتورینو — نمونه فایل تنظیمات محیطی
#  این فایل را به .env کپی کنید یا بگذارید install.php آن را بسازد.
#  هرگز فایل .env واقعی را در گیت قرار ندهید.
# ============================================================

# محیط اجرا: production | development
APP_ENV=production

# نمایش جزئیات خطا (فقط روی سرور توسعه true باشد)
APP_DEBUG=false

# نشانی نصب برنامه (بدون اسلش انتهایی)
APP_URL=http://localhost/factorino

# کلید امنیتی — رشته تصادفی ۶۴ کاراکتری.
# install.php این مقدار را خودکار می‌سازد. برای ساخت دستی:
#   php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# ------------------------------------------------------------
# پایگاه داده (MySQL / MariaDB)
# ------------------------------------------------------------
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=factorino_db
DB_USER=root
DB_PASSWORD=

# ------------------------------------------------------------
# نشست‌ها (بر حسب ثانیه)
# ------------------------------------------------------------
SESSION_TTL_APP=1209600
SESSION_TTL_ADMIN=14400

# ------------------------------------------------------------
# محدودسازی ورود
# ------------------------------------------------------------
LOGIN_MAX_ATTEMPTS_IP=20
LOGIN_MAX_ATTEMPTS_EMAIL=6
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900

# اگر پشت Cloudflare یا پراکسی معکوس هستید true کنید
TRUST_PROXY=false
